2. Delete Head of Linked List

class Solution:
    def deleteHead(self, head):
        temp = head.next
        head.next = None
        return temp
    
3. Length of Linked List

class Solution:
    def getCount(self, head):
        temp = head
        count = 0
        
        while temp!=None:
            count = count + 1
            temp = temp.next
        
        return count

4. Search in Linked List

class Solution:
    def searchKey(self, head, key):
        temp = head
        
        while temp!=None:
            if temp.data == key:
                return True
            temp = temp.next
        
        return False

5. Insertion in a Doubly Linked List

class Solution:
    def insertAtPos(self, head, p, x):
        # Code Here
        ans = Node(x)
        temp = head
        
        for _ in range(p):
            temp = temp.next
            
        ans.next = temp.next
        ans.prev = temp
        
        if temp.next:
            temp.next.prev = ans
            
        temp.next = ans
        return head

6. Delete Head of Doubly Linked List

class Solution:
    def deleteHead(self, head):
        # code here
        
        temp = head.next
        temp.prev = None
        head.next = None
        return temp

7. Reverse a Doubly Linked List

class Solution:
    def reverse(self, head):
        cur = head
        ansHead = None
        
        while cur!=None:
            cur.prev, cur.next = cur.next, cur.prev
            ansHead = cur
            cur = cur.prev
            
        return ansHead

8. Middle of the Linked List

class Solution:
    def middleNode(self, head: Optional[ListNode]) -> Optional[ListNode]:
        slow = fast = head

        while fast and fast.next!=None:
            slow=slow.next
            fast=fast.next.next
        return slow

9. Reverse Linked List

class Solution:
    def reverseList(self, head: Optional[ListNode]) -> Optional[ListNode]:
        curr = head
        prev = None
        nxt = None

        while curr!=None:
            nxt = curr.next
            curr.next = prev
            prev = curr
            curr = nxt

        return prev

