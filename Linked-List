3. Length of Linked List

class Solution:
    def getCount(self, head):
        temp = head
        count = 0
        
        while temp!=None:
            count = count + 1
            temp = temp.next
        
        return count

4. Search in Linked List

class Solution:
    def searchKey(self, head, key):
        temp = head
        
        while temp!=None:
            if temp.data == key:
                return True
            temp = temp.next
        
        return False

5. Insertion in a Doubly Linked List

class Solution:
    def insertAtPos(self, head, p, x):
        # Code Here
        ans = Node(x)
        temp = head
        
        for _ in range(p):
            temp = temp.next
            
        ans.next = temp.next
        ans.prev = temp
        
        if temp.next:
            temp.next.prev = ans
            
        temp.next = ans
        return head

6. Delete Head of Doubly Linked List

class Solution:
    def deleteHead(self, head):
        # code here
        
        temp = head.next
        temp.prev = None
        head.next = None
        return temp

7. Reverse a Doubly Linked List

class Solution:
    def reverse(self, head):
        cur = head
        ansHead = None
        
        while cur!=None:
            cur.prev, cur.next = cur.next, cur.prev
            ansHead = cur
            cur = cur.prev
            
        return ansHead

8. Middle of the Linked List

class Solution:
    def middleNode(self, head: Optional[ListNode]) -> Optional[ListNode]:
        slow = fast = head

        while fast and fast.next!=None:
            slow=slow.next
            fast=fast.next.next
        return slow

9. Reverse Linked List

class Solution:
    def reverseList(self, head: Optional[ListNode]) -> Optional[ListNode]:
        curr = head
        prev = None
        nxt = None

        while curr!=None:
            nxt = curr.next
            curr.next = prev
            prev = curr
            curr = nxt

        return prev

10. Linked List Cycle

class Solution:
    def hasCycle(self, head: Optional[ListNode]) -> bool:
        slow = fast = head

        while fast and fast.next!=None:
            slow = slow.next
            fast = fast.next.next

            if slow == fast:
                return True

        return False

11. Linked List Cycle II

class Solution:
    def detectCycle(self, head: Optional[ListNode]) -> Optional[ListNode]:
        slow = fast = head

        # Step 1: Detect if a cycle exists
        while fast and fast.next:
            slow = slow.next
            fast = fast.next.next

            if slow == fast:
                # Step 2: Find the cycle starting node
                slow = head

                while slow != fast:
                    slow = slow.next
                    fast = fast.next

                return slow

        return None

12. Cycle Length in Linked List

class Solution:
    def lengthOfLoop(self, head):
        slow = head
        fast = head

        while fast and fast.next:
            slow = slow.next
            fast = fast.next.next
            
            if slow == fast:
                slow = head
                
                while slow!=fast:
                    slow=slow.next
                    fast=fast.next
                
                cnt = 1
                temp = slow.next
                while temp!=slow:
                    cnt = cnt+1
                    temp=temp.next
                return cnt
        
        return 0

