1. Linked List Insertion At Beginning

"""
class Node:

    def __init__(self, data):
        self.data = data
        self.next = None
"""

class Solution:
    def insertAtFront(self, head, x):
       temp = Node(x)
       temp.next = head
       return temp

2. Delete Head of Linked List

class Solution:
    def deleteHead(self, head):
        temp = head.next
        head.next = None
        return temp
    
