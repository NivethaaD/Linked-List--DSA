1. Linked List Insertion At Beginning

"""
class Node:

    def __init__(self, data):
        self.data = data
        self.next = None
"""

class Solution:
    def insertAtFront(self, head, x):
       temp = Node(x)
       temp.next = head
       return temp

2. Delete Head of Linked List

class Solution:
    def deleteHead(self, head):
        temp = head.next
        head.next = None
        return temp
    
3. Length of Linked List

class Solution:
    def getCount(self, head):
        temp = head
        count = 0
        
        while temp!=None:
            count = count + 1
            temp = temp.next
        
        return count

4. Search in Linked List

class Solution:
    def searchKey(self, head, key):
        temp = head
        
        while temp!=None:
            if temp.data == key:
                return True
            temp = temp.next
        
        return False
